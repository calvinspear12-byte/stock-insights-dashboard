# TEMPLATE for the future "ChatGPT writes the analysis automatically" step.
# To enable: add an OPENAI_API_KEY repo secret, then rename this file to
# .github/workflows/ai-refresh.yml. Costs a few cents per run (pay-as-you-go OpenAI API).
name: AI analysis refresh (optional)

on:
  # weekly on Sunday 08:00 UTC; change or add schedules as you like
  schedule:
    - cron: '0 8 * * 0'
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  ai:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Rewrite analysis blocks with the OpenAI API
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: python ai_refresh.py
      - name: Commit
        run: |
          git config user.name "ai-bot"
          git config user.email "actions@users.noreply.github.com"
          git add index.html
          if git diff --cached --quiet; then
            echo "no change"
          else
            git commit -m "AI analysis refresh"
            git pull --rebase --autostash origin main || true
            git push origin main
          fi
